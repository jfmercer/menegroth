{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Weekly, matching the retired Dependabot cadence.
  schedule: ["* 0-6 * * 1"],
  timezone: "Etc/UTC",
  // Don't PR a release until it has aged a week — a compromised release is
  // usually yanked within days (same rationale as the old dependabot cooldown).
  minimumReleaseAge: "7 days",
  dependencyDashboard: true,
  labels: ["dependencies"],
  // Keep GitHub Actions pinned to a full SHA with a `# vX.Y.Z` comment, exactly
  // as the supply-chain policy (docs/architecture.md D7) requires.
  pinDigests: true,
  // Nothing auto-merges: every bump is a PR a human reviews before it lands.
  enabledManagers: [
    "github-actions",
    "terraform",
    "pre-commit",
    "ansible-galaxy",
    "custom.regex",
  ],
  // Regex managers for pins no native manager understands. Each reads a
  // `# renovate: datasource=… depName=…` annotation on the line above the pin.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/\\.pkr\\.hcl$/", "/\\.ya?ml$/", "/defaults/main\\.yml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s+[\\w.]+\\s*[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
    {
      // Packer hcloud plugin: quote-aware match so the `~> 1.7` constraint is
      // captured whole (the generic annotation manager stops at whitespace).
      customType: "regex",
      managerFilePatterns: ["/\\.pkr\\.hcl$/"],
      matchStrings: [
        "source\\s*=\\s*\"github\\.com/hetznercloud/hcloud\"\\s+version\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      depNameTemplate: "hetznercloud/packer-plugin-hcloud",
      datasourceTemplate: "github-releases",
      versioningTemplate: "hashicorp",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      // nemoclaw: bump the tag and its pinned commit together (the commit is
      // the trust anchor — see roles/nemoclaw/defaults/main.yml).
      customType: "regex",
      managerFilePatterns: ["/roles/nemoclaw/defaults/main\\.yml$/"],
      matchStrings: [
        "nemoclaw_install_tag:\\s*(?<currentValue>\\S+)[\\s\\S]*?nemoclaw_install_commit:\\s*(?<currentDigest>\\S+)",
      ],
      depNameTemplate: "NVIDIA/NemoClaw",
      datasourceTemplate: "github-tags",
    },
  ],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
    },
    {
      matchManagers: ["terraform", "ansible-galaxy"],
      groupName: "infra providers",
    },
    {
      // tailscale is baked into the Packer initramfs — its own PR, flagged so
      // the reviewer knows a Packer rebuild + kernel-survival test is required.
      matchDepNames: ["tailscale/tailscale"],
      groupName: "tailscale (packer)",
      addLabels: ["needs-packer-rebuild"],
    },
    {
      // nemoclaw is alpha, SHA-pinned deliberately — always a standalone PR
      // held for manual review of the release diff.
      matchDepNames: ["NVIDIA/NemoClaw"],
      groupName: "nemoclaw",
      addLabels: ["review-required"],
    },
  ],
}
