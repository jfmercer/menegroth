# {{ ansible_managed }}
# Universal-auth credentials of the "server" machine identity.
# Scope: member of the dedicated server project only, read-only on
# {{ infisical_server_secret_path }} — the identity is NOT a member of the
# CI/unlock project, which is what stops it reading /unlock (D8). Revoke in the
# Infisical console if this host is ever suspected compromised.
INFISICAL_API_URL={{ infisical_api_url }}
INFISICAL_PROJECT_ID={{ infisical_server_project_id }}
INFISICAL_ENV_SLUG={{ infisical_env_slug }}
INFISICAL_SECRET_PATH={{ infisical_server_secret_path }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID={{ infisical_server_client_id }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET={{ infisical_server_client_secret }}
