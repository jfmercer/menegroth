#!/usr/bin/env bash
# {{ ansible_managed }}
# Lightweight health checks; alerts to ntfy only when something is wrong.
set -uo pipefail

problems=()

# Encrypted volume mounted?
mountpoint -q {{ luks_volume_mount | default('/data') }} \
  || problems+=("/data is NOT mounted — data-volume.service failed?")

# Disk usage
while read -r usep mnt; do
  usep="${usep%\%}"
  if (( usep >= {{ ops_disk_alert_percent }} )); then
    problems+=("Disk ${mnt} at ${usep}%")
  fi
done < <(df --output=pcent,target -x tmpfs -x devtmpfs -x overlay | tail -n +2)

# Failed systemd units
failed="$(systemctl --failed --no-legend --plain | awk '{print $1}')"
[[ -n "$failed" ]] && problems+=("Failed units: $(tr '\n' ' ' <<<"$failed")")

# Tailscale up?
state="$(tailscale status --json 2>/dev/null | jq -r .BackendState)"
[[ "$state" == "Running" ]] || problems+=("Tailscale backend state: ${state:-unknown}")

# OOM kills in the agent stack: nemoclaw.slice holds every Docker container
# (sandboxes, k3s, OpenShell gateway); the user slice holds the nemoclaw CLI.
# The kernel counter is cumulative since boot, so alert only when it has
# grown since the last run (state resets naturally when a reboot zeroes it).
for slice in nemoclaw.slice user.slice/user-{{ nemoclaw_uid | default(1500) }}.slice; do
  events="/sys/fs/cgroup/$slice/memory.events"
  seen_file="/var/lib/server-healthcheck/oom_kill_seen.${slice##*/}"
  [[ -f "$events" ]] || continue
  ooms="$(awk '$1 == "oom_kill" {print $2}' "$events")"
  ooms="${ooms:-0}"
  seen="$(cat "$seen_file" 2>/dev/null || echo 0)"
  ((ooms > seen)) && problems+=("${slice##*/}: $((ooms - seen)) new OOM kill(s) (${ooms} since boot)")
  mkdir -p "${seen_file%/*}"
  echo "$ooms" >"$seen_file"
done

# Dead-man heartbeat (D10): ping on EVERY run. The external monitor alerts
# when pings STOP — the only signal for a server that never came back from
# a reboot (stuck at the unlock prompt, failed boot-node join, or down), when
# neither this script nor the Mac agent's boot-node alerts can fire.
heartbeat_url="$(/usr/local/bin/infisical-get {{ ops_heartbeat_secret }} 2>/dev/null)" \
  && curl -fsS -m 10 --retry 3 "$heartbeat_url" >/dev/null \
  || echo "healthcheck: heartbeat ping failed (the monitor will alert if this persists)" >&2

# (No array-length expansion here: its brace-hash opens a Jinja comment.)
[[ -z "${problems[*]-}" ]] && exit 0

ntfy_url="$(/usr/local/bin/infisical-get NTFY_TOPIC_URL 2>/dev/null)" || {
  echo "healthcheck: problems found but could not fetch NTFY_TOPIC_URL" >&2
  printf ' - %s\n' "${problems[@]}" >&2
  exit 1
}

printf -v body ' - %s\n' "${problems[@]}"
curl -fsS -m 15 \
  -H "Title: $(hostname) health alert" \
  -H "Priority: high" \
  -H "Tags: warning" \
  -d "$body" \
  "$ntfy_url" >/dev/null
