#!/bin/sh
# initramfs-tools init-premount SCRIPT: bring up DHCP networking and join
# the tailnet as an ephemeral tag:boot-unlock node so the Mac unlock agent
# can reach dropbear and supply the LUKS passphrase.
PREREQ="udev"
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac
# shellcheck disable=SC1091 # exists only inside the running initramfs
. /scripts/functions

configure_networking

# DNS for the OAuth key exchange (`tailscale up` resolves api.tailscale.com
# itself; tailscaled has its own bootstrap DNS). Use the DHCP-provided
# resolvers from configure_networking, falling back to Hetzner's.
if [ ! -s /etc/resolv.conf ]; then
  for conf in /run/net-*.conf; do
    # shellcheck disable=SC1090 # written by configure_networking at runtime
    [ -f "$conf" ] && . "$conf"
  done
  for ns in "${IPV4DNS0:-}" "${IPV4DNS1:-}"; do
    [ -n "$ns" ] && [ "$ns" != "0.0.0.0" ] && echo "nameserver $ns" >>/etc/resolv.conf
  done
  [ -s /etc/resolv.conf ] || printf 'nameserver 185.12.64.1\nnameserver 185.12.64.2\n' >/etc/resolv.conf
fi

modprobe tun 2>/dev/null || true
mkdir -p /dev/net
[ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200
mkdir -p /var/lib/tailscale /var/run /tmp

# Logs go to /run/initramfs, which init creates before init-premount. Not
# /var/log: the initramfs has none, and a failed redirect means the shell
# never starts the command. /run moves to the real root at pivot, so after a
# console unlock both logs are still readable (docs/troubleshooting.md §7).
log_begin_msg "tailscale-boot: starting tailscaled"
/usr/bin/tailscaled \
  --state=/var/lib/tailscale/tailscaled.state \
  --socket=/var/run/tailscale.sock \
  --tun=tailscale0 >/run/initramfs/tailscaled-boot.log 2>&1 &

# Bounded: init-premount runs BEFORE the cryptroot passphrase prompt, so an
# unbounded `tailscale up` (default --timeout=0 waits forever, e.g. during a
# Tailscale outage) would also hide the Hetzner-console fallback prompt.
# Worst case here is ~10 x (15 s + 3 s) = 3 min, then the prompt appears.
joined=0
i=0
while [ "$i" -lt 10 ]; do
  if /usr/bin/tailscale --socket=/var/run/tailscale.sock up \
      --auth-key=file:/etc/tailscale-boot/authkey \
      --advertise-tags="$(cat /etc/tailscale-boot/tags)" \
      --hostname="$(cat /etc/tailscale-boot/hostname)" \
      --accept-dns=false --accept-routes=false \
      --timeout=15s >>/run/initramfs/tailscale-up.log 2>&1; then
    joined=1
    break
  fi
  i=$((i + 1))
  sleep 3
done

if [ "$joined" -eq 1 ]; then
  log_success_msg "tailscale-boot: tailnet joined, awaiting unlock"
else
  # Boot continues: the local console (Hetzner web console) still shows the
  # passphrase prompt, so a failed tailnet join never bricks the box.
  log_failure_msg "tailscale-boot: could not join tailnet; console unlock only"
fi
log_end_msg
