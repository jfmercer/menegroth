<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for the Menegroth server FDE unlock. __HOME__ is replaced by
     install.sh; launchd does not expand ~ itself. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.menegroth-server.unlock</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/bin/menegroth-server-unlock</string>
  </array>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/menegroth-server-unlock/agent.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/menegroth-server-unlock/agent.log</string>
</dict>
</plist>
