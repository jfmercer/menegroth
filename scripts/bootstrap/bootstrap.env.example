# Bootstrap configuration — copy to bootstrap.env and edit.
# bootstrap.env is gitignored: it holds NO secrets, only non-sensitive names
# and locations. Seed *credentials* are passed via the environment (or you are
# prompted for them) — see the SEEDS section at the bottom.

# ---- Infisical --------------------------------------------------------------
INFISICAL_DOMAIN="https://eu.infisical.com"   # EU region — matches the workflows
INFISICAL_ENV="prod"
INFISICAL_PROJECT_SLUG="menegroth"
# Project ID (Infisical console -> Project Settings -> Project ID). Not secret.
INFISICAL_PROJECT_ID="REPLACE_WITH_PROJECT_ID"

# ---- HCP Terraform / GitHub -------------------------------------------------
TF_CLOUD_ORGANIZATION="menegroth"
# GITHUB_REPO="jfmercer/menegroth"   # optional; gh infers from the cwd repo

# ---- Hetzner ----------------------------------------------------------------
HCLOUD_LOCATION="nbg1"

# ---- Tailscale --------------------------------------------------------------
TAILNET="-"                                    # "-" = the tailnet the token owns
SERVER_TAG="tag:server"
CI_TAG="tag:ci"
BOOT_TAG="tag:boot-unlock"

# ---- 1Password / Mac unlock -------------------------------------------------
OP_VAULT="Menegroth"
BOOT_HOSTNAME="ai-server-boot"
ADMIN_SSH_COMMENT="ai-server-admin"

# ---- ntfy -------------------------------------------------------------------
NTFY_BASE="https://ntfy.sh"
# NTFY_TOPIC_URL is generated (random topic) if unset; set it to reuse a topic.
# NTFY_TOPIC_URL="https://ntfy.sh/menegroth-alerts-xxxxxxxx"

# ---- SEEDS (secrets — DO NOT put values in this file) -----------------------
# Provide these in your shell before running bootstrap.sh (or you'll be
# prompted). They are the irreducible hand-created credentials:
#
#   export HCLOUD_TOKEN=...                  # Hetzner R/W API token
#   export TS_API_TOKEN=...                  # Tailscale API access token (mints keys, pushes ACL)
#   export TS_OAUTH_CLIENT_ID=...            # Tailscale tag:ci OAuth client (for CI)
#   export TS_OAUTH_SECRET=...
#   export TF_API_TOKEN=...                  # HCP Terraform token
#   export INFISICAL_CLIENT_ID=...           # ci machine identity (-> GitHub)
#   export INFISICAL_CLIENT_SECRET=...
#   export SERVER_IDENTITY_CLIENT_ID=...     # server machine identity (-> /ci)
#   export SERVER_IDENTITY_CLIENT_SECRET=...
#   export ANTHROPIC_API_KEY=...             # -> /server
#
# The script must also be able to WRITE to Infisical: run `infisical login`
# first, or export INFISICAL_TOKEN=... (a user/service token, not the ci id).
